DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=lazyio
WORKERS=4
BIND_ADDRESS=0.0.0.0
PORT=8000

# Telegram storage (primary)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
# PREFERRED: user session (full scan + stream access).
# Generate once with: python generate_session.py
TELEGRAM_SESSION_STRING=paste_session_string_here
# Fallback: bot token (upload-only; bots cannot read channel history).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Channel username (e.g. @mymusicchannel) or numeric id (e.g. -4445012381)
TELEGRAM_SOURCE_CHANNEL=@your_channel_username
TELEGRAM_SESSION=lazyio_bot

# S3 Storage Configuration (legacy fallback only)
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
